# Hyperdrome environment (SPEC.md 15). Copy to .env.local and fill in; never commit .env.local.
# docs/runbooks/dev-setup.md walks through each value.

# Neon Postgres connection string (pooled). Any other Postgres URL uses node-postgres (tests, CI).
DATABASE_URL=
# Auth.js secret: openssl rand -base64 32. Also guards the server-only demo sign-in.
AUTH_SECRET=
# Google OAuth client (Google Cloud console, redirect URI <app>/api/auth/callback/google).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Shared secret for the scheduler calling /api/races/run (Vercel cron or an external one): openssl rand -hex 32.
CRON_SECRET=

# NEAR network; only testnet is supported.
NEAR_NETWORK=testnet
# RPC primary and failover; unset uses dRPC public then FastNear (both keyless).
NEAR_RPC_URL=
NEAR_RPC_FAILOVER_URL=
# Optional FastNear key, sent as Authorization: Bearer to the FastNear URL.
NEAR_RPC_API_KEY=
# Owner account (signs ops calls) and the game contract account.
NEAR_OWNER_ID=hyperdrome.testnet
NEAR_GAME_ID=game.hyperdrome.testnet
# Function-call secret keys (ed25519:...): ops key on the owner, settlement key on the contract.
NEAR_OPS_KEY=
NEAR_SETTLEMENT_KEY=
# AES-256-GCM keys for sealed player keys, one pair per environment: openssl rand -hex 32 each.
KEY_ENCRYPTION_KEY=
ADMIN_KEY_ENCRYPTION_KEY=

# Pusher Channels app (server) and its public key and cluster (browser).
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=
# Block explorer for transaction and account links.
NEXT_PUBLIC_EXPLORER_URL=https://testnet.nearblocks.io
# The site's own address (metadata, og:url and og:image, sitemap, robots, token metadata);
# default https://hyperdrome-near.vercel.app. Read at build time.
NEXT_PUBLIC_SITE_URL=
# Comma-separated admin emails for /api/admin/config; empty means no admins.
ADMIN_EMAILS=
# Lifetime number of Play Demo accounts (default 100).
DEMO_ACCOUNT_CAP=

# real (default) or mock: the in-memory chain adapter, for tests and offline work.
NEAR_ADAPTER=
# 1 runs tests/near/testnet.integration.test.js against testnet.
NEAR_TESTNET_INTEGRATION=
# The app scripts/smoke-testnet.mjs runs against (default http://localhost:3000).
SMOKE_BASE_URL=
