# ------------------------------------------------------------------
# Drone Manager — environment variables
# Copy to .env.local and fill in real values. Never commit .env.local.
# ------------------------------------------------------------------

# Neon Postgres pooled connection string.
# Get from https://console.neon.tech — use the "pooled" variant for serverless.
DATABASE_URL=

# Canonical public URL for NextAuth (no trailing slash).
# Local dev: http://localhost:3000 — production: https://yourdomain.com
NEXTAUTH_URL=http://localhost:3000

# NextAuth encryption secret. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Resend API key for magic-link email delivery.
# Get from https://resend.com (free tier: 3000 emails/month).
RESEND_API_KEY=

# Shared secret that protects the /api/races/run cron endpoint.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# ------------------------------------------------------------------
# MegaETH NFT minting (Phase 3)
# ------------------------------------------------------------------

# Private key of the deployer wallet that owns HyperdromeDrone and is the
# only address allowed to call mint(). NEVER reuse a wallet that holds
# real funds. Server-only - do NOT expose with a NEXT_PUBLIC_ prefix.
DEPLOYER_PRIVATE_KEY=

# Deployed HyperdromeDrone contract address on MegaETH testnet v2.
# NEXT_PUBLIC_ so the drone detail page can render explorer links
# without an extra round-trip. Public information; safe to expose.
NEXT_PUBLIC_DRONE_CONTRACT_ADDRESS=

# MegaETH testnet v2 JSON-RPC endpoint. Carrot host serves chain id 6343
# (chain id 6342 is the deprecated v1 testnet).
MEGAETH_RPC_URL=https://carrot.megaeth.com/rpc

# Deployed HyperdromeVOLT (ERC-20) contract address on MegaETH testnet v2.
# Server-only: the VOLT balance endpoint reads on-chain balances; no client
# component imports this address.
VOLT_CONTRACT_ADDRESS=

# Deployed HyperdromeSkin (ERC-721) contract address on MegaETH testnet v2.
# Server-only: skin mints + metadata service read this address. NFT-explorer
# links can be derived server-side and embedded in API responses.
SKIN_CONTRACT_ADDRESS=

# Deployed HyperdromeMod (ERC-721) contract address on MegaETH testnet v2.
# Server-only: mod mints + metadata service read this address.
MOD_CONTRACT_ADDRESS=

# Deployed HyperdromeMarketplace contract address on MegaETH testnet v2.
# Server-only: the marketplace service mirrors DB list/buy/cancel to this
# contract. 10% of each sale flows to the deployer wallet (testnet
# treasury); the rest goes to the seller.
MARKETPLACE_CONTRACT_ADDRESS=

# Deployed HyperdromeSettlement contract address on MegaETH testnet v2.
# The race cron submits one settleEpoch(epochId, results[]) per tick to
# this contract. After deploy, the operator must call
# HyperdromeVOLT.setMinter(<settlement>, true) so settlement can mint
# race rewards. Optional - the cron no-ops on-chain settlement when this
# is unset.
SETTLEMENT_CONTRACT_ADDRESS=
