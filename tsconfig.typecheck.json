{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "jsx": "preserve",
    "types": ["node"],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "types/**/*.d.ts",
    "tests/**/*.js",
    "lib/near/**/*.js",
    "lib/game-engine/**/*.js",
    "tests/near/**/*.js",
    "lib/http/**/*.js",
    "lib/validators/player-slug.js",
    "lib/auth/**/*.js",
    "services/bootstrap.service.js",
    "services/bootstrap-kit.js",
    "services/demo.service.js",
    "app/api/auth/bootstrap/**/*.js",
    "app/api/auth/demo/**/*.js",
    "lib/db/index.js",
    "lib/db/schema.js"
  ]
}
