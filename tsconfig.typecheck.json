{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "jsx": "preserve",
    "types": ["node"],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "types/**/*.d.ts",
    "tests/**/*.js",
    "lib/near/**/*.js",
    "lib/game-engine/**/*.js",
    "tests/near/**/*.js",
    "lib/http/**/*.js",
    "lib/validators/player-slug.js",
    "lib/auth/**/*.js",
    "services/bootstrap.service.js",
    "services/bootstrap-kit.js",
    "services/demo.service.js",
    "app/api/auth/bootstrap/**/*.js",
    "app/api/auth/demo/**/*.js",
    "lib/db/index.js",
    "lib/db/schema.js",
    "lib/db/schema-gameplay.js",
    "lib/validators/gameplay.js",
    "lib/metadata/**/*.js",
    "services/action.service.js",
    "services/action-lease.js",
    "services/chain-cache.service.js",
    "services/gameplay.service.js",
    "services/pack-open.service.js",
    "services/rate-limit.service.js",
    "services/metadata.service.js",
    "app/api/drones/*/allocate/**/*.js",
    "app/api/drones/*/equip/**/*.js",
    "app/api/drones/*/bind/**/*.js",
    "app/api/drones/*/toggle/**/*.js",
    "app/api/drones/vendor/**/*.js",
    "app/api/marketplace/list/**/*.js",
    "app/api/marketplace/buy/**/*.js",
    "app/api/marketplace/cancel/**/*.js",
    "app/api/packs/**/*.js",
    "app/api/metadata/**/*.js",
    "lib/client/**/*.js",
    "services/batch.service.js",
    "services/settle.service.js",
    "services/settle-store.js",
    "services/scheduler.service.js",
    "services/scheduler-deps.js",
    "services/race-replay.js",
    "services/race-schedule.service.js",
    "services/race.service.js",
    "services/chain-cache-rows.js",
    "services/chain-cache-settle.js",
    "app/api/races/run/**/*.js",
    "app/api/races/next/**/*.js",
    "app/api/races/upcoming/**/*.js",
    "app/api/races/*/verify/**/*.js",
    "scripts/tick.mjs",
    "lib/teams/**/*.js",
    "services/teams.service.js",
    "services/team-seed.service.js",
    "services/team-seed-kit.js",
    "scripts/seed-teams.mjs",
    "lib/world/**/*.js",
    "services/world-seed.service.js",
    "services/catalog.service.js",
    "services/health.service.js",
    "app/api/health/**/*.js",
    "app/api/skins/catalog/**/*.js",
    "scripts/register-alias.mjs",
    "scripts/seed-world.mjs",
    "scripts/smoke-testnet.mjs",
    "scripts/smoke-client.mjs",
    "services/race-rewards-backfill.js",
    "scripts/backfill-race-rewards.mjs"
  ]
}
