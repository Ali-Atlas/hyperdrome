{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "jsx": "preserve",
    "types": ["node"],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "types/**/*.d.ts",
    "tests/**/*.js",
    "lib/near/**/*.js",
    "lib/game-engine/**/*.js",
    "tests/near/**/*.js"
  ]
}
