{
  "name": "dronemanager-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "format": "node scripts/format.mjs --write",
    "format:check": "node scripts/format.mjs --check",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "test": "vitest run",
    "db:studio": "drizzle-kit studio",
    "seed": "node --env-file=.env.local lib/db/seed.js",
    "seed:marketplace": "node --env-file=.env.local lib/db/seed-marketplace.js",
    "seed:more-drones": "node --env-file=.env.local lib/db/seed-more-drones.js",
    "seed:world": "node --env-file=.env.local --import ./scripts/register-alias.mjs scripts/seed-world.mjs",
    "smoke": "node --env-file=.env.local --import ./scripts/register-alias.mjs scripts/smoke-testnet.mjs",
    "prepare": "husky",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "1.11.3",
    "@neondatabase/serverless": "^1.0.2",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.8.0",
    "near-api-js": "7.4.0",
    "next": "16.4.4",
    "next-auth": "5.0.0-beta.32",
    "pg": "8.23.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.19.2",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
